# device infor for homeassistant
MQTT_IDENTIFIER=gardyn_03
MQTT_BASETOPIC=gardyn
MQTT_DEVICE_MODEL="gardyn 3.0"
MQTT_VERSION="1.0.0"

# MQTT broker config
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=gardyn
MQTT_PASSWORD=somepassword
MQTT_KEEPALIVE_INTERVAL=60

WATER_LOW_CM=11

DISTANCE_SENSOR_ENABLED=true

UPPER_CAMERA_DEVICE=/dev/video0
LOWER_CAMERA_DEVICE=/dev/video2
UPPER_IMAGE_PATH=/tmp/upper_camera.jpg
LOWER_IMAGE_PATH=/tmp/lower_camera.jpg
CAMERA_RESOLUTION="640x480"
IMAGE_INTERVAL_SECONDS=3600

# --- Sensor stub toggles (flip to false when real hardware is wired) ---
PH_STUB=true
EC_STUB=true
DOSE_STUB=true
WATER_TEMP_STUB=true

# --- Atlas EZO I2C addresses (only used when stubs are off) ---
PH_I2C_ADDRESS=0x63
EC_I2C_ADDRESS=0x64

# --- Daily AI garden analysis via Anthropic ---
# Set AI_ANALYSIS_ENABLED=true and provide ANTHROPIC_API_KEY to enable.
# .env is gitignored so the key stays out of source control.
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_MODEL=claude-opus-4-7
ANTHROPIC_API_KEY=
